# Copy this file to .env for local testing, or set these as environment
# variables on your hosting platform (Render, Railway, etc.) directly.
# NEVER commit a real .env file with secrets.

PORT=3000

# Admin login for /admin.html — change these before deploying
ADMIN_USER=admin
ADMIN_PASS=changeme123

# Random long string used to sign the admin session cookie
SESSION_SECRET=replace-this-with-a-long-random-string

# Supabase project (Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use the SERVICE ROLE key (secret) here, never the anon/public key.
# This app only uses it on the server; it is never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
